# Core API Key (fill in tomorrow at kickoff)
LLM_API_KEY=

# Search & ranking agent (backend/agent.py)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
FIRECRAWL_API_KEY=
# Listing sites searched in parallel (comma-separated): spitogatos, xe, booking. Default: all.
SEARCH_SOURCES=spitogatos,xe,booking

# Oumi Iris Decision Model (POST https://inference.oumi.ai/v1/systemone)
OUMI_API_KEY=
OUMI_PROJECT_ID=

# Landlord outreach (backend/outreach/) — see OUTREACH.md
# Safety: while true, messages are composed but NOT sent. Set to false to send for real.
OUTREACH_DRY_RUN=true
# Demo safety: when set, every real SMS / e-mail goes here instead of to the landlord.
OUTREACH_OVERRIDE_PHONE=
OUTREACH_OVERRIDE_EMAIL=
OUTREACH_MAX_CONCURRENCY=5
# Enabled channels (comma-separated): sms, email, call. SMS is disabled for now.
# "call" is a live voice call placed from the browser with Vapi (NEXT_PUBLIC_VAPI_PUBLIC_KEY).
OUTREACH_CHANNELS=email,call

# Calendar used by the outreach agent to propose viewing slots (optional; users can also paste it
# in Settings). Google Calendar → Settings → your calendar → "Secret address in iCal format".
GOOGLE_CALENDAR_ICS_URL=
OUTREACH_TIMEZONE=Europe/Athens

# Twilio SMS (https://console.twilio.com)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Either a Twilio phone number in E.164 (+1...) or a Messaging Service SID (MG...)
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=

# Resend e-mail (https://resend.com/api-keys)
RESEND_API_KEY= 
# Must be on a domain verified in Resend. Default: "Relocation Agent <onboarding@resend.dev>"
# (only delivers to the e-mail address that owns the Resend account).
RESEND_FROM_EMAIL=

# Server settings
PORT=8000
NEXT_PUBLIC_API_URL=http://localhost:8000
# Browser origins allowed to call the API (comma-separated). "*" = any. In production set it to
# the frontend URL, e.g. https://your-frontend.up.railway.app
CORS_ALLOW_ORIGINS=*

# Frontend (frontend/.env.local, read by Next.js): Vapi *public* key for live voice calls.
# Without it, calls fall back to the browser's own speech synthesis + recognition.
# NEXT_PUBLIC_VAPI_PUBLIC_KEY=
